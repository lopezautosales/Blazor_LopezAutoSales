@page "/app/inventory/add"
@attribute [Authorize(Roles = "Admin")]
@inject AuthHttp auth
@inject NavigationManager nav
@inject IJSRuntime js
@inject VINDecoder decoder

<h1 class="text-center">Add Vehicle</h1>
<EditForm Model="car" OnValidSubmit="SubmitVehicle">
    <DataAnnotationsValidator />
    <ErrorDisplay Errors="Errors" />
    <div class="mb-3">
        <label for="VIN">VIN</label>
        <div class="input-group">
            <InputText id="VIN" class="form-control" @bind-Value="car.VIN"></InputText>
            <div class="input-group-append">
                <button type="button" class="btn btn-secondary" @onclick="async () => await decoder.TryDecodeAsync(car)">Verify</button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label for="Year">Year</label>
            <InputNumber id="Year" class="form-control" @bind-Value="car.Year"></InputNumber>
        </div>
        <div class="col-md-3">
            <label for="Make">Make</label>
            <InputText id="Make" class="form-control" @bind-Value="car.Make"></InputText>
        </div>
        <div class="col-md-3">
            <label for="Model">Model</label>
            <InputText id="Model" class="form-control" @bind-Value="car.Model"></InputText>
        </div>
        <div class="col-md-3">
            <label for="Color">Color</label>
            <InputText id="Color" class="form-control" @bind-Value="car.Color"></InputText>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label for="Mileage">Mileage</label>
            <InputNumber id="Mileage" class="form-control" placeholder="Exempt" @bind-Value="car.Mileage"></InputNumber>
        </div>
        <div class="col-md-3">
            <label for="BoughtPrice">Bought Price</label>
            <InputNumber id="BoughtPrice" class="form-control" @bind-Value="car.BoughtPrice"></InputNumber>
        </div>
        <div class="col-md-3">
            <label for="ListPrice">List Price</label>
            <InputNumber id="ListPrice" class="form-control" @bind-Value="car.ListPrice"></InputNumber>
        </div>
        <div class="col-md-3 my-auto">
            <div class="form-check">
                <InputCheckbox class="form-check-input" id="salvageCheck" @bind-Value="car.IsSalvage"></InputCheckbox>
                <label class="form-check-label" for="salvageCheck">Is Salvage</label>
            </div>
        </div>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Submit
        </button>
    </div>
</EditForm>

@code {
    private Car car = new Car();
    private List<string> Errors { get; set; } = new List<string>();
    private bool _busy;

    private async Task SubmitVehicle()
    {
        _busy = true;
        try
        {
            await decoder.TryDecodeAsync(car);
            var response = await auth.Client.PostAsJsonAsync<Car>("/api/inventory", car);
            if (response.IsSuccessStatusCode)
            {
                string id = await response.Content.ReadAsStringAsync();
                nav.NavigateTo($"/app/inventory/edit/{id}");
            }
            else
                await js.InvokeVoidAsync("alert", await response.Content.ReadAsStringAsync());
        }
        finally
        {
            _busy = false;
        }
    }
}
