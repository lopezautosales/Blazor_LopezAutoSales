@page "/app/inventory"
@attribute [Authorize(Roles = "Admin")]
@inject AuthHttp auth
@inject CarManager carManager

<h1 class="text-center">Inventory</h1>
<div class="row mb-2">
    <div class="col-6">
        <a class="btn btn-secondary" href="/app/inventory/sell">Sell Vehicle</a>
    </div>
    <div class="col-6 text-end">
        <a href="/app/inventory/add" class="btn btn-secondary"><i class="mdi mdi-plus"></i> Add Vehicle</a>
    </div>
</div>
@if (cars is null)
{
    <p class="lead">Loading...</p>
}
else if (!cars.Any())
{
    <p class="lead">There's currently no active vehicles in inventory.</p>
}
else
{
    <div class="table-responsive">
        <QuickGrid Items="cars" Class="table table-striped table-hover">
            <PropertyColumn Property="@(c => c.Year)" Sortable="true" Align="Align.Center" />
            <PropertyColumn Property="@(c => c.Make)" Sortable="true" IsDefaultSortColumn="true" Align="Align.Center" />
            <PropertyColumn Property="@(c => c.Model)" Sortable="true" Align="Align.Center" />
            <TemplateColumn Title="Mileage" SortBy="@(GridSort<Car>.ByAscending(c => c.Mileage))" Align="Align.End">
                @context.MileageString()
            </TemplateColumn>
            <TemplateColumn Title="Bought Price" SortBy="@(GridSort<Car>.ByAscending(c => c.BoughtPrice))" Align="Align.End">
                @if (context.BoughtPrice.HasValue)
                {
                    @context.BoughtPrice.Value.ToString("C")
                }
                else
                {
                    <span class="badge text-bg-danger">Missing</span>
                }
            </TemplateColumn>
            <PropertyColumn Title="List Price" Property="@(c => c.ListPrice)" Format="C" Sortable="true" Align="Align.End" />
            <TemplateColumn Title="Salvage" SortBy="@(GridSort<Car>.ByAscending(c => c.IsSalvage))" Align="Align.Center">
                @if (context.IsSalvage)
                {
                    <span class="badge text-bg-warning">Salvage</span>
                }
                else
                {
                    <span class="text-muted">Clean</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Actions" Align="Align.Center">
                <div class="btn-group" role="group">
                    <a href="/app/warranty/@context.Id" class="btn btn-secondary">Warranty</a>
                    <a href="/app/inventory/edit/@context.Id" class="btn btn-secondary" @onclick="() => SetData(context)">Edit</a>
                    <a href="/app/inventory/sell/@context.Id" class="btn btn-secondary">Sell</a>
                </div>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <div class="d-flex justify-content-end gap-4 fw-bold border-top pt-2 mt-2">
        <span>@cars.Count() in stock</span>
        <span>List value: @cars.Sum(c => c.ListPrice).ToString("C")</span>
        <span>Cost: @cars.Sum(c => c.BoughtPrice ?? 0).ToString("C")</span>
    </div>
}

@code {
    private IQueryable<Car> cars;

    protected override async Task OnInitializedAsync()
    {
        var result = await auth.Client.GetFromJsonAsync<IEnumerable<Car>>("/api/inventory");
        cars = result.AsQueryable();
        await base.OnInitializedAsync();
    }

    private void SetData(Car car)
    {
        carManager.SetCar(car);
    }
}
