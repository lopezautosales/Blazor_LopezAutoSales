@page "/app"
@attribute [Authorize(Roles = "Admin")]
@inject AuthHttp auth
@* "Account" in this namespace is the Account.razor component, so alias the model. *@
@using Acct = LopezAutoSales.Shared.Models.Account

<h1 class="text-center">Dashboard</h1>

@if (loading)
{
    <p class="lead text-center">Loading...</p>
}
else
{
    <div class="row g-3 my-2">
        <div class="col-12 col-md-6 col-xl-3">
            <a href="/app/inventory" class="text-decoration-none text-reset">
                <div class="card dash-card h-100">
                    <div class="card-body">
                        <div class="text-uppercase small text-muted">In stock</div>
                        <div class="display-6">@inStock</div>
                        <div class="small text-muted">Lot @lotValue.ToString("C0") · cost @costBasis.ToString("C0")</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <a href="/app/report" class="text-decoration-none text-reset">
                <div class="card dash-card h-100">
                    <div class="card-body">
                        <div class="text-uppercase small text-muted">Sales this month</div>
                        <div class="display-6">@monthSalesCount</div>
                        <div class="small text-muted">@monthRevenue.ToString("C0") revenue</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <a href="/app/payments" class="text-decoration-none text-reset">
                <div class="card dash-card h-100">
                    <div class="card-body">
                        <div class="text-uppercase small text-muted">Outstanding</div>
                        <div class="display-6">@receivables.ToString("C0")</div>
                        <div class="small text-muted">across @openAccounts open account@(openAccounts == 1 ? "" : "s")</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <a href="/app/payments" class="text-decoration-none text-reset">
                <div class="card dash-card h-100">
                    <div class="card-body">
                        <div class="text-uppercase small text-muted">Past due</div>
                        <div class="display-6 @(pastDue > 0 ? "text-danger" : null)">@pastDue</div>
                        <div class="small text-muted">@pastDueAmount.ToString("C0") late</div>
                    </div>
                </div>
            </a>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private int inStock, monthSalesCount, openAccounts, pastDue;
    private decimal lotValue, costBasis, monthRevenue, receivables, pastDueAmount;

    protected override async Task OnInitializedAsync()
    {
        DateTime today = DateTime.Today;
        List<Car> inventory = await auth.Client.GetFromJsonAsync<List<Car>>("/api/inventory");
        List<Sale> sales = await auth.Client.GetFromJsonAsync<List<Sale>>($"/api/sale/{today.Year}");
        List<Acct> accounts = await auth.Client.GetFromJsonAsync<List<Acct>>("/api/account");

        inStock = inventory.Count;
        lotValue = inventory.Sum(x => x.ListPrice);
        costBasis = inventory.Sum(x => x.BoughtPrice ?? 0);

        List<Sale> monthSales = sales.Where(x => x.Date.Month == today.Month).ToList();
        monthSalesCount = monthSales.Count;
        monthRevenue = monthSales.Sum(x => x.SellingPrice);

        List<Acct> open = accounts.Where(x => !x.IsPaid).ToList();
        openAccounts = open.Count;
        receivables = open.Sum(x => x.Balance());
        List<Acct> due = open.Where(x => x.LateDue() > 0).ToList();
        pastDue = due.Count;
        pastDueAmount = due.Sum(x => x.LateDue());

        loading = false;
    }
}
