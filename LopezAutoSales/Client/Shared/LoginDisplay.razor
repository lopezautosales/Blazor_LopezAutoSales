@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Navigation
@inject CookieAuthenticationStateProvider AuthProvider

<AuthorizeView>
    <Authorized>
        <li class="nav-item">
            <span class="nav-link"><i class="mdi mdi-account"></i> @context.User.Identity.Name</span>
        </li>
        <li class="nav-item">
            <button class="btn nav-link" @onclick="BeginSignOut"><i class="mdi mdi-logout"></i> Logout</button>
        </li>
    </Authorized>
    <NotAuthorized>
        <li class="nav-item">
            <a class="nav-link" href="/app/login"><i class="mdi mdi-login"></i> Login</a>
        </li>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task BeginSignOut()
    {
        await AuthProvider.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
