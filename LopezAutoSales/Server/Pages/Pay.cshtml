@page "/pay"
@model PayModel
@{
    ViewBag.Title = "Make a Payment";
}

<div class="page-hero">
    <p class="eyebrow">In-house financing</p>
    <h1>Make a Payment</h1>
    <p>Pay your monthly note online with your bank account. Look up your account below.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card p-4 mb-4">
            <h2 class="h5 mb-3">Find my account</h2>
            <form method="post" asp-page-handler="Lookup" data-single-submit data-busy-text="Looking up&hellip;">
                <div class="mb-3">
                    <label class="form-label" for="LastName">Last name</label>
                    <input class="form-control" id="LastName" asp-for="LastName" autocomplete="off" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="VinLast4">Last 4 of your vehicle's VIN</label>
                    @* inputmode=text, not numeric — VIN position 14 can be a letter. *@
                    <input class="form-control" id="VinLast4" asp-for="VinLast4" maxlength="4" inputmode="text"
                           autocapitalize="characters" autocomplete="off" placeholder="1234" required />
                    <div class="form-text">You can find your VIN on your registration or insurance card.</div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Find my account</button>
            </form>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info">
                @Model.Message
                Questions? Call <a href="tel:16202086250">(620) 208-6250</a>.
            </div>
        }

        @if (Model.Found)
        {
            <div class="card p-4">
                <h2 class="h5 mb-3">Confirm your payment</h2>
                <dl class="row mb-3">
                    <dt class="col-5">Account holder</dt>
                    <dd class="col-7">@Model.MaskedBuyer</dd>
                    <dt class="col-5">Vehicle</dt>
                    <dd class="col-7">@Model.CarLabel</dd>
                    <dt class="col-5">VIN</dt>
                    <dd class="col-7">@Model.VinMask</dd>
                    <dt class="col-5">Amount due now</dt>
                    <dd class="col-7"><strong>@Model.AmountDue.ToString("C")</strong></dd>
                    <dt class="col-5">Remaining balance</dt>
                    <dd class="col-7">@Model.RemainingBalance.ToString("C")</dd>
                </dl>

                @if (Model.PaymentsAvailable)
                {
                    <form method="post" asp-page-handler="Pay" data-single-submit data-busy-text="Opening secure payment&hellip;">
                        <input type="hidden" asp-for="Token" />
                        <div class="mb-3">
                            <label class="form-label" for="Amount">Amount to pay</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" id="Amount" asp-for="Amount" type="number" step="0.01"
                                       min="1" max="@Model.RemainingBalance" />
                            </div>
                            <div class="form-text">Pay the amount due, or any amount up to your remaining balance. Entering more than your balance only charges the balance.</div>
                        </div>
                        <p class="form-text">
                            You'll finish on the next screen — pay by one-time bank debit or by card.
                            Payments are processed securely by Stripe; your bank and card details never touch our servers.
                        </p>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="mdi mdi-lock"></i> Continue to secure payment
                        </button>
                        <p class="form-text mt-2 mb-0">
                            <i class="mdi mdi-information-outline"></i>
                            Bank payments take a few business days to clear, so they won't show here right away.
                            If you paid online in the last few days, it's already on the way.
                        </p>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        Online payments are temporarily unavailable. Please call us at
                        <a href="tel:16202086250">(620) 208-6250</a> to make a payment.
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Disable the submit button on post: OnPostPay makes an outbound Stripe call before
        // redirecting, so on slow mobile the button feels dead and a second click would
        // create a duplicate Checkout session. Handler names live in the form action, so
        // disabling the button doesn't change what gets posted.
        document.querySelectorAll("form[data-single-submit]").forEach(function (form) {
            form.addEventListener("submit", function () {
                var btn = form.querySelector("button[type=submit]");
                if (!btn || btn.disabled) return;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>'
                    + (form.dataset.busyText || "Working…");
            });
        });
    </script>
}
