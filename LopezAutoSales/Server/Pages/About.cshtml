@page
@using LopezAutoSales.Shared
@{
    ViewData["Title"] = "About";
}

<div class="page-hero">
    <p class="eyebrow">Emporia, Kansas</p>
    <h1>About the Lot</h1>
    <p>Family-owned, honest used vehicles with in-house financing — straight terms, no surprises.</p>
</div>

<div class="card overflow-hidden mb-4">
    <div class="map-embed">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6253.232203458573!2d-96.20214562370916!3d38.40412456859883!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87b94e781bbffbe7%3A0xd3590d9ae4f13aac!2sLopez+Auto+Sales!5e0!3m2!1sen!2sus!4v1560835977693!5m2!1sen!2sus" title="Map to Lopez Auto Sales" allowfullscreen loading="lazy" sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card info-card h-100 p-4">
            <div class="info-icon"><i class="mdi mdi-clock-outline"></i></div>
            <h2 class="h4">Hours</h2>
            <p class="lead">@Dealership.Hours</p>
            <ul class="mb-0">
                <li>@Dealership.HoursNote.</li>
                <li><a href="tel:16202086250">Call ahead</a> and we'll have it ready.</li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card info-card h-100 p-4">
            <div class="info-icon"><i class="mdi mdi-cash-multiple"></i></div>
            <h2 class="h4">Financing</h2>
            <p class="lead">We have in-house financing.</p>
            <ul class="mb-0">
                <li>Put <strong>1/2 down</strong>.</li>
                <li>Pay <strong>$300/month</strong>.</li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card info-card h-100 p-4">
            <div class="info-icon"><i class="mdi mdi-swap-horizontal"></i></div>
            <h2 class="h4">Trade-ins</h2>
            <p class="lead">We also accept trade-ins.</p>
            <ul class="mb-0">
                <li>Vehicles must be in good condition that run and drive.</li>
                <li>Your trade-in can count towards your down payment.</li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card info-card h-100 p-4">
            <div class="info-icon"><i class="mdi mdi-shield-check"></i></div>
            <h2 class="h4">Our Warranty</h2>
            <p class="lead">A standard warranty on all of our vehicles.</p>
            <ul class="mb-0">
                <li><strong>20%</strong> on engine and transmission for <strong>30 days or 1,000 miles</strong>.</li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card info-card h-100 p-4">
            <div class="info-icon"><i class="mdi mdi-file-document-outline"></i></div>
            <h2 class="h4">Buying a Vehicle</h2>
            <p class="lead">You'll need the following:</p>
            <ul class="mb-0">
                <li>A driver's license</li>
                <li>Proof of insurance</li>
                <li>A down payment</li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card info-card h-100 p-4">
            <div class="info-icon"><i class="mdi mdi-steering"></i></div>
            <h2 class="h4">Test Drives</h2>
            <p class="lead">We allow test drives for up to 30 minutes.</p>
            <ul class="mb-0">
                <li>Bring a valid driver's license.</li>
                <li>You're welcome to take vehicles to your own trusted mechanic.</li>
            </ul>
        </div>
    </div>
</div>
