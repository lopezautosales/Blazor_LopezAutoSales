@page "/pay/cancelled"
@model CancelledModel
@{
    ViewBag.Title = "Payment cancelled";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6 text-center py-5">
        <div class="info-icon mx-auto mb-3"><i class="mdi mdi-close-circle-outline"></i></div>
        <h1 class="h3">Payment cancelled</h1>
        <p class="lead">No charge was made.</p>
        <a href="/pay" class="btn btn-primary mt-3"><i class="mdi mdi-cash"></i> Try again</a>
    </div>
</div>
