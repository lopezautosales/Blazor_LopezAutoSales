<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>@ViewBag.Title - Lopez Auto Sales</title>
    <meta name="theme-color" content="#02bbee" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/dist/css/materialdesignicons.min.css" rel="stylesheet" />
    <link href="~/css/app.css" rel="stylesheet" />
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-179267166-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-179267166-1');
    </script>
</head>

<body class="d-flex flex-column min-vh-100">
    <nav class="sticky-top navbar navbar-expand-lg navbar-dark app-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">Lopez Auto Sales</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTop" aria-controls="navbarTop" aria-expanded="false" aria-label="Toggle navigation">
                <i class="mdi mdi-menu"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarTop">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="mdi mdi-car"></i> Inventory</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/about"><i class="mdi mdi-information"></i> About</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-message"></i> Contact Us
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="https://goo.gl/maps/YZoFvQTUptU8cASW8" target="_blank"><i class="mdi mdi-map"></i> Directions</a></li>
                            <li><a class="dropdown-item" href="tel:16202086250"><i class="mdi mdi-phone"></i> Phone</a></li>
                            <li><a class="dropdown-item" href="mailto:lopezauto@outlook.com"><i class="mdi mdi-email"></i> Email</a></li>
                        </ul>
                    </li>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/app"><i class="mdi mdi-clipboard"></i> App</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/app/login"><i class="mdi mdi-login"></i> Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div role="main" class="container">
        @RenderBody()
    </div>
    <footer class="site-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <h5>Lopez Auto Sales, Inc.</h5>
                    <p class="mb-0">Quality used vehicles with in-house financing in Emporia, Kansas.</p>
                </div>
                <div class="col-md-4">
                    <h5>Visit Us</h5>
                    <p class="mb-1"><i class="mdi mdi-map-marker"></i> 515 Albert St, Emporia, KS 66801</p>
                    <p class="mb-0"><a href="https://goo.gl/maps/YZoFvQTUptU8cASW8" target="_blank">Get directions</a></p>
                </div>
                <div class="col-md-3">
                    <h5>Contact</h5>
                    <p class="mb-1"><i class="mdi mdi-phone"></i> <a href="tel:16202086250">(620) 208-6250</a></p>
                    <p class="mb-0"><i class="mdi mdi-email"></i> <a href="mailto:lopezauto@outlook.com">lopezauto@outlook.com</a></p>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255,255,255,.12)" />
            <small style="color: rgba(226,232,240,.55); font-family: 'Roboto Mono', monospace; font-size: .78rem;">&copy; @DateTime.Now.Year Lopez Auto Sales, Inc.</small>
        </div>
    </footer>
    <script src="~/dist/js/jquery.slim.min.js"></script>
    <script src="~/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>
