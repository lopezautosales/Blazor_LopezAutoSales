@page
@model LopezAutoSales.Server.Pages.ErrorModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="mb-3">Something went wrong</h1>
    <p class="lead">Sorry about that — please try again in a moment, or give us a call at
        <a href="tel:16202086250">(620) 208-6250</a>.</p>
    <a href="/" class="btn btn-primary btn-lg mt-2"><i class="mdi mdi-car"></i> Back to inventory</a>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted mt-4 mb-0"><small>Reference: <code>@Model.RequestId</code></small></p>
    }
</div>
